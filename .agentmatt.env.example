# AgentMatt Environment Variables
# Copy this file to .agentmatt.env and fill in your credentials

# ── Twilio ─────────────────────────────────────────────────────────────────────
# Get from console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15550001234

# ── ElevenLabs ─────────────────────────────────────────────────────────────────
# Get API key from app.elevenlabs.io → Profile → API Key
# Create voice clone: Voices → Add Voice → Instant Voice Clone
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_cloned_voice_id

# ── Anthropic ──────────────────────────────────────────────────────────────────
# Get from console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
# CRITICAL: Twilio needs to reach this server. Use ngrok for local dev:
#   npx ngrok http 3001
# Then paste the https URL here:
PUBLIC_URL=https://your-ngrok-subdomain.ngrok.io

# ── Provider ───────────────────────────────────────────────────────────────────
PROVIDER_NAME=Matt
